generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator serverClient {
  provider     = "prisma-client"
  output       = "../../server/src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  customer   Customer?
  email      String    @unique
  password   String
  role_id    String    @db.Uuid
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  role Role @relation(fields: [role_id], references: [id])

  influencer    Influencer?
  notifications Notification[]
  audit_logs    AuditLog[]

  @@index([email])
  @@index([role_id])
  @@map("users")
}

model Role {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  roles Role[]

  @@map("permissions")
}

model Customer {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @unique @db.Uuid
  first_name String
  last_name  String
  phone      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  user      User              @relation(fields: [user_id], references: [id])
  addresses CustomerAddress[]
  orders    Order[]
  rewards   CustomerReward[]

  @@map("customers")
}

model CustomerAddress {
  id          String    @id @default(uuid()) @db.Uuid
  customer_id String    @db.Uuid
  address     String
  city        String
  region      String?
  country     String
  is_default  Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  customer Customer @relation(fields: [customer_id], references: [id])

  @@index([customer_id])
  @@map("customer_addresses")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  products Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  products Product[]

  @@map("brands")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  category_id String    @db.Uuid
  brand_id    String    @db.Uuid
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  status      String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  category Category         @relation(fields: [category_id], references: [id])
  brand    Brand            @relation(fields: [brand_id], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@index([category_id])
  @@index([brand_id])
  @@index([name])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id         String    @id @default(uuid()) @db.Uuid
  product_id String    @db.Uuid
  sku        String    @unique
  size       String?
  color      String?
  edition    String?
  price      Decimal?  @db.Decimal(12, 2)
  status     String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  purchase_items PurchaseItem[]

  product     Product             @relation(fields: [product_id], references: [id])
  inventory   Inventory?
  movements   InventoryMovement[]
  order_items OrderItem[]

  @@index([product_id])
  @@map("product_variants")
}

model ProductImage {
  id         String    @id @default(uuid()) @db.Uuid
  product_id String    @db.Uuid
  image_url  String
  alt_text   String?
  is_primary Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  product Product @relation(fields: [product_id], references: [id])

  @@index([product_id])
  @@map("product_images")
}

model Inventory {
  id         String    @id @default(uuid()) @db.Uuid
  variant_id String    @unique @db.Uuid
  quantity   Int       @default(0)
  min_stock  Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("inventory")
}

model InventoryMovement {
  id            String    @id @default(uuid()) @db.Uuid
  variant_id    String    @db.Uuid
  quantity      Int
  movement_type String
  reference     String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  deleted_by    String?   @db.Uuid

  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@index([variant_id])
  @@index([movement_type])
  @@map("inventory_movements")
}

model Supplier {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  phone      String?
  email      String?
  address    String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  purchases Purchase[]

  @@index([name])
  @@map("suppliers")
}

model Purchase {
  id              String    @id @default(uuid()) @db.Uuid
  supplier_id     String    @db.Uuid
  purchase_number String    @unique
  purchase_date   DateTime  @default(now())
  total_amount    Decimal   @db.Decimal(12, 2)
  status          String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid
  deleted_by      String?   @db.Uuid

  supplier Supplier       @relation(fields: [supplier_id], references: [id])
  items    PurchaseItem[]

  @@index([supplier_id])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(uuid()) @db.Uuid
  purchase_id String    @db.Uuid
  variant_id  String    @db.Uuid
  quantity    Int
  unit_cost   Decimal   @db.Decimal(12, 2)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  purchase Purchase       @relation(fields: [purchase_id], references: [id])
  variant  ProductVariant @relation(fields: [variant_id], references: [id])

  @@index([purchase_id])
  @@index([variant_id])
  @@map("purchase_items")
}

model Order {
  id           String    @id @default(uuid()) @db.Uuid
  customer_id  String    @db.Uuid
  order_number String    @unique
  source       String
  status       String
  total_amount Decimal   @db.Decimal(12, 2)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  created_by   String?   @db.Uuid
  updated_by   String?   @db.Uuid
  deleted_by   String?   @db.Uuid

  customer                   Customer    @relation(fields: [customer_id], references: [id])
  items                      OrderItem[]
  payment                    Payment?
  delivery                   Delivery?
  referrals                  Referral[]
  influencer_discount_amount Decimal     @default(0) @db.Decimal(12, 2)

  @@index([customer_id])
  @@index([order_number])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String    @id @default(uuid()) @db.Uuid
  order_id   String    @db.Uuid
  variant_id String    @db.Uuid
  quantity   Int
  unit_price Decimal   @db.Decimal(12, 2)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  order   Order          @relation(fields: [order_id], references: [id])
  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@index([order_id])
  @@index([variant_id])
  @@map("order_items")
}

model PaymentMethod {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  payments Payment[]

  @@map("payment_methods")
}

model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  order_id              String    @unique @db.Uuid
  payment_method_id     String    @db.Uuid
  amount                Decimal   @db.Decimal(12, 2)
  status                String
  transaction_reference String?
  paid_at               DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  deleted_at            DateTime?
  created_by            String?   @db.Uuid
  updated_by            String?   @db.Uuid
  deleted_by            String?   @db.Uuid

  order          Order         @relation(fields: [order_id], references: [id])
  payment_method PaymentMethod @relation(fields: [payment_method_id], references: [id])

  @@index([payment_method_id])
  @@index([status])
  @@map("payments")
}

model Delivery {
  id              String    @id @default(uuid()) @db.Uuid
  order_id        String    @unique @db.Uuid
  delivery_status String
  address         String
  tracking_number String?
  provider        String?
  delivered_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid
  deleted_by      String?   @db.Uuid

  order Order @relation(fields: [order_id], references: [id])

  @@index([delivery_status])
  @@map("deliveries")
}

model Influencer {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String    @unique @db.Uuid
  referral_code   String    @unique
  status          String
  commission_rate Decimal   @db.Decimal(5, 2)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid
  deleted_by      String?   @db.Uuid

  user        User                @relation(fields: [user_id], references: [id])
  referrals   Referral[]
  commissions Commission[]
  withdrawals WithdrawalRequest[]

  customer_discount_rate Decimal @default(0) @db.Decimal(5, 2)

  @@map("influencers")
}

model Referral {
  id            String    @id @default(uuid()) @db.Uuid
  influencer_id String    @db.Uuid
  order_id      String?   @db.Uuid
  referral_code String
  status        String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  deleted_by    String?   @db.Uuid

  influencer Influencer @relation(fields: [influencer_id], references: [id])
  order      Order?     @relation(fields: [order_id], references: [id])

  commissions Commission[]

  @@index([influencer_id])
  @@index([order_id])
  @@index([referral_code])
  @@map("referrals")
}

model Commission {
  id            String    @id @default(uuid()) @db.Uuid
  influencer_id String    @db.Uuid
  referral_id   String?   @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  status        String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  deleted_by    String?   @db.Uuid

  influencer Influencer @relation(fields: [influencer_id], references: [id])
  referral   Referral?  @relation(fields: [referral_id], references: [id])

  @@index([influencer_id])
  @@index([referral_id])
  @@map("commissions")
}

model WithdrawalRequest {
  id                String    @id @default(uuid()) @db.Uuid
  influencer_id     String    @db.Uuid
  amount            Decimal   @db.Decimal(12, 2)
  status            String
  payment_reference String?
  processed_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  deleted_by        String?   @db.Uuid

  influencer Influencer @relation(fields: [influencer_id], references: [id])

  @@index([influencer_id])
  @@index([status])
  @@map("withdrawal_requests")
}

model Banner {
  id         String    @id @default(uuid()) @db.Uuid
  title      String
  image_url  String
  link_url   String?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  @@map("banners")
}

model Promotion {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  discount_type  String
  discount_value Decimal   @db.Decimal(12, 2)
  start_date     DateTime
  end_date       DateTime
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  created_by     String?   @db.Uuid
  updated_by     String?   @db.Uuid
  deleted_by     String?   @db.Uuid

  @@index([start_date, end_date])
  @@map("promotions")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  title      String
  message    String
  type       String
  is_read    Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String?   @db.Uuid
  action     String
  entity     String
  entity_id  String?   @db.Uuid
  details    String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid

  user User? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([entity, entity_id])
  @@map("audit_logs")
}

model SystemSetting {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  value       String
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  @@map("system_settings")
}

model CustomerRewardRule {
  id                       String    @id @default(uuid()) @db.Uuid
  name                     String
  purchase_count_threshold Int?
  spending_threshold       Decimal?  @db.Decimal(12, 2)
  reward_type              String
  reward_value             Decimal?  @db.Decimal(12, 2)
  gift_description         String?
  is_active                Boolean   @default(true)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  deleted_at               DateTime?
  created_by               String?   @db.Uuid
  updated_by               String?   @db.Uuid
  deleted_by               String?   @db.Uuid

  rewards CustomerReward[]

  @@map("customer_reward_rules")
}

model CustomerReward {
  id               String    @id @default(uuid()) @db.Uuid
  customer_id      String    @db.Uuid
  reward_rule_id   String    @db.Uuid
  reward_type      String
  reward_value     Decimal?  @db.Decimal(12, 2)
  gift_description String?
  status           String
  awarded_at       DateTime  @default(now())
  redeemed_at      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid
  deleted_by       String?   @db.Uuid

  customer    Customer           @relation(fields: [customer_id], references: [id])
  reward_rule CustomerRewardRule @relation(fields: [reward_rule_id], references: [id])

  @@index([customer_id])
  @@index([reward_rule_id])
  @@index([status])
  @@map("customer_rewards")
}
