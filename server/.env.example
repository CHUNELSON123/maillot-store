# WhatsApp Business Cloud API. Use mock while setting up; use cloud for Meta's test or business number.
WHATSAPP_MODE=mock
WHATSAPP_ADMIN_PHONE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_INFLUENCER_APPROVED=influencer_approved
WHATSAPP_TEMPLATE_INFLUENCER_REJECTED=influencer_rejected
WHATSAPP_TEMPLATE_WITHDRAWAL_REQUEST=influencer_withdrawal_request
WHATSAPP_TEMPLATE_NEWSLETTER_WELCOME=newsletter_subscription_confirmed
FRONTEND_URL=http://localhost:3001

# Sandbox checkout only. Use a test public key and set the callback to the actual storefront URL.
NOTCHPAY_MODE=mock
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_HASH_KEY=
NOTCHPAY_CALLBACK_URL=http://localhost:3000/payment-result

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
